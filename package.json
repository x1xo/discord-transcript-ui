{
	"name": "discord-transcript-ui",
	"version": "1.1.1",
	"description": "Dependency-free, light-DOM custom elements and one stylesheet for rendering Discord chat transcripts in plain HTML.",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"./dist/discord-transcript.min.js",
		"./src/discord-transcript.js"
	],
	"main": "dist/discord-transcript.min.js",
	"style": "dist/discord-transcript.min.css",
	"unpkg": "dist/discord-transcript.min.js",
	"jsdelivr": "dist/discord-transcript.min.js",
	"exports": {
		".": "./dist/discord-transcript.min.js",
		"./css": "./dist/discord-transcript.min.css",
		"./manifest.json": "./dist/manifest.json",
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"files": [
		"dist/",
		"src/",
		"README.md",
		"LICENSE",
		"ATTRIBUTION.md"
	],
	"scripts": {
		"build": "node build/build.mjs",
		"build:check": "node build/build.mjs --check",
		"verify": "node build/verify.mjs",
		"scaffold": "node tools/scaffold.mjs",
		"serve": "node build/serve.mjs",
		"demo": "node build/serve.mjs",
		"preview": "node tools/scaffold.mjs --body examples/messages.html --out examples/local-preview.html --config examples/config.js --local --title \"local preview\""
	},
	"devDependencies": {
		"esbuild": "^0.25.12"
	},
	"keywords": [
		"discord",
		"transcript",
		"transcripts",
		"webcomponents",
		"custom-elements",
		"light-dom",
		"css"
	],
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	}
}
